# Vates Kube OS — kernel configuration fragment
# systemd-boot executes the kernel directly as an EFI image; without the EFI stub
# there is no bootable kernel for it to load.
CONFIG_EFI_STUB=y
#
# The console draws through DRM (cairo + libdrm) and the splash may draw through
# /dev/fb0. The node has NO module loader: no udev, no systemd, nothing runs
# modprobe. A driver built as a module (`=m`, the defconfig default for most of
# these) is therefore never loaded, and the /dev/dri/card0 the console looks for
# never appears. Everything here is `=y` on purpose.
#
# Framebuffer path (splash, and any fbdev console):
#   CONFIG_FB                      the framebuffer layer itself
#   CONFIG_DRM_FBDEV_EMULATION     DRM exposes /dev/fb0 through it
#   CONFIG_DRM_SIMPLEDRM           a generic fb for the boot framebuffer
#   CONFIG_SYSFB_SIMPLEFB          gives SIMPLEDRM the firmware's framebuffer
# DRM/KMS path (the graphical console):
#   CONFIG_DRM_VIRTIO_GPU          QEMU/virtio-gpu
#   CONFIG_DRM_BOCHS               QEMU standard VGA
#   CONFIG_DRM_QXL                 QEMU qxl
#   CONFIG_DRM_CIRRUS_QEMU         Xen Orchestra's default VGA

CONFIG_FB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
# SYSFB_SIMPLEFB is what gives SIMPLEDRM something to bind to: it marks the
# firmware's framebuffer (the EFI GOP on a UEFI guest, VBE on a BIOS one) as a
# generic system framebuffer, and simpledrm turns it into /dev/dri/card0 and
# /dev/fb0. Without it, nothing drives the VGA until a native DRM driver binds,
# and a guest whose vGPU no native driver claims shows NOTHING -- no boot splash,
# no dashboard, black from the firmware handoff on. Measured on an imported image
# where the guest tools were detected, so the OS was up; only the screen was dead.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_QXL=y
# Cirrus, the VGA Xen Orchestra gives a VM by default (the "cirrus" vGPU type).
# Without it there is no /dev/dri/card0 on such a VM, and vates-console falls
# back to the text face. The native driver takes over from simpledrm when it
# binds; simpledrm stays the fallback for a vGPU none of these claims.
CONFIG_DRM_CIRRUS_QEMU=y

# overlayfs: containerd's default snapshotter mounts overlay to build a
# container's rootfs. Built as a module (the defconfig default) it is never
# loaded, and every container fails with "mount ... fstype: overlay ... no such device".
CONFIG_OVERLAY_FS=y

# Container networking. The kubelet, kube-proxy and flannel need a bridge, veth
# pairs and the netfilter pieces; as modules they would not be loaded either.
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y

# cgroup v2 device controller. runc sets device rules through a BPF program
# attached to the cgroup; without CONFIG_CGROUP_BPF, container creation fails
# with "bpf_prog_query(BPF_CGROUP_DEVICE) failed: function not implemented".
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y

# eBPF datapath (Cilium). Cilium attaches BPF programs with tc and uses the BPF
# JIT; a driver left as a module would never be loaded here (there is no module
# loader), and Cilium's own preflight refuses a kernel without these. BTF is what
# Cilium reads from /sys/kernel/btf/vmlinux to learn the kernel's types, and it
# costs a debug-info build and host pahole.
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_ACT_BPF=y
CONFIG_FUNCTION_TRACER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y

# The rest of Cilium's list, checked against docs.cilium.io/operations/
# system_requirements. All =y for the same reason: nothing loads a module here.
# The iptables-masquerade and L7/FQDN sets are what its default and policy code
# reaches for; the tunnel and bandwidth ones cover modes a cluster can pick
# without a rebuild.
CONFIG_CRYPTO_SHA1=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_GENEVE=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NET_SCH_FQ=y

# User namespaces. runc looks for /proc/self/setgroups to decide whether the
# host procfs is safe to reuse; without CONFIG_USER_NS it is absent and the
# container fails with "unsafe procfs detected: openat2 ... setgroups: no such
# file or directory".
CONFIG_USER_NS=y
# nftables. The image's `iptables` is the nft variant (there is no legacy one for
# kube-proxy to use), so the kernel needs nf_tables -- a module in the defconfig,
# hence never loaded here. Without it: "iptables: Could not fetch rule set
# generation id: Invalid argument", and no pod networking.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y

# cgroup v1 memory and cpuset controllers. The kubelet's cgroupfs driver uses
# cgroup v1 (cgroup v2 would need the systemd driver), but the v1 halves of
# memory and cpuset are gated behind these options: without them the controllers
# are absent from /proc/cgroups and mounting them fails with
# "cgroup: Unknown subsys name 'memory'".
CONFIG_MEMCG_V1=y
CONFIG_CPUSETS_V1=y

# CFS bandwidth control. The cpu controller's cpu.cfs_period_us /
# cpu.cfs_quota_us (v1) and cpu.max (v2) exist only when this is enabled; without
# it runc cannot set a container's cpu limit and every pod fails with
# "cpu.cfs_period_us: no such file or directory" (v1) or "cpu.max: no such file
# or directory" (v2). This was the root cause behind both.
CONFIG_CFS_BANDWIDTH=y

# nftables, complete. The image's `iptables` is iptables-nft, and kube-proxy and
# flannel are built on it; a partial nf_tables fails with
# "RULE_APPEND failed (No such file or directory): rule in chain KUBE-FIREWALL"
# and both pods crash-loop.
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_CHAIN_ROUTE_IPV4=y
CONFIG_NFT_CHAIN_NAT_IPV4=y
CONFIG_NFT_CHAIN_ROUTE_IPV6=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_REJECT=y
# NETFILTER_ADVANCED gates most xt matches (comment, multiport, set, ...): with
# it off they are silently dropped from the build, and kube-proxy fails with
# "Extension comment revision 0 not supported, missing kernel module?".
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_SET=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# VXLAN: flannel's overlay. A module in the defconfig, never loaded here.
CONFIG_VXLAN=y

# The running kernel's own configuration, exposed at /proc/config.gz.
#
# kubeadm's SystemVerification reads it there. Without it, it tries to load the
# `configs` module -- which this kernel does not have, because the config is not
# a module -- and the check fails. On `kubeadm join` that failure is fatal, so a
# joining control plane never joins: measured,
#   [ERROR SystemVerification]: failed to parse kernel config: unable to load
#   kernel module: "configs"
# and the node came up as an ordinary worker with no control plane components.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Xen guest (Xen Orchestra / XCP-ng). The XCP-ng documentation says the Xen
# drivers are built into the kernel and only the management agent has to be
# installed -- true of a distribution, whose kernel was configured for it. This
# kernel comes from the x86_64 defconfig and carries nothing it was not asked
# for, so the guest side is turned on here, and =y for the same reason as the
# rest of this file: there is no module loader.
#
# XENFS + XEN_COMPAT_XENFS are what the agent actually needs: they create
# /proc/xen/xenbus, which xe-daemon opens to reach the hypervisor. XEN_PVHVM is
# the HVM/PVH guest support Xen Orchestra boots; XEN_PVH additionally allows a
# PVH boot. Under KVM/libvirt (the test cluster) none of this is used -- the
# kernel does not detect Xen and stays native.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_XEN=y
CONFIG_XEN_PVHVM_GUEST=y
CONFIG_XEN_PVH=y
CONFIG_XENFS=y
CONFIG_XEN_COMPAT_XENFS=y
