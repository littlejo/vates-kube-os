# Build artifacts.
#
# Reproducible from the sources in this repository, and none of them belong in
# version control.

# NoCloud config drives. Generated by scripts/mkconfigdrive.sh from the
# directories beside them (test/fixtures/cfgdrive, -capi, -cp, seed), so the ISO
# is a derived file, not a source.
/test/fixtures/*.iso

# Go binary output: `make cluster` builds vateskctl here.
/build/bin/

# Developer notes (dense design documents, not for the public docs).
/notes/

# Local secrets and values (XO token, etc.)
.env
